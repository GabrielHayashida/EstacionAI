CREATE USER SA PASSWORD DIGEST 'd41d8cd98f00b204e9800998ecf8427e'
ALTER USER SA SET LOCAL TRUE
CREATE SCHEMA PUBLIC AUTHORIZATION DBA
SET SCHEMA PUBLIC
CREATE MEMORY TABLE PUBLIC.VAGA(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,DESCRICAO VARCHAR(100),OCUPADA BOOLEAN)
ALTER TABLE PUBLIC.VAGA ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.ESTACIONAMENTO(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NOME VARCHAR(100),VALOR_NORMAL DECIMAL(10,2),VALOR_FIXO DECIMAL(10,2),EMAIL VARCHAR(100))
ALTER TABLE PUBLIC.ESTACIONAMENTO ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.CLIENTE(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NOME VARCHAR(100),DATA_NASCIMENTO DATE,ENDERECO VARCHAR(150),EMAIL VARCHAR(100),TELEFONE VARCHAR(20))
ALTER TABLE PUBLIC.CLIENTE ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.USUARIO(LOGIN VARCHAR(50) PRIMARY KEY,SENHA VARCHAR(100),ESTACIONAMENTO_ID INTEGER,FOREIGN KEY(ESTACIONAMENTO_ID) REFERENCES PUBLIC.ESTACIONAMENTO(ID))
CREATE MEMORY TABLE PUBLIC.VEICULO(PLACA VARCHAR(10) PRIMARY KEY,MARCA VARCHAR(50),MODELO VARCHAR(50),COR VARCHAR(20),ACESSO BOOLEAN,CLIENTE_ID INTEGER,FOREIGN KEY(CLIENTE_ID) REFERENCES PUBLIC.CLIENTE(ID))
CREATE MEMORY TABLE PUBLIC.RESERVA(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,DATA_HORA_ENTRADA TIMESTAMP,DATA_HORA_SAIDA TIMESTAMP,VALOR_TOTAL DECIMAL(10,2),CLIENTE_ID INTEGER,VEICULO_PLACA VARCHAR(10),VAGA_ID INTEGER,ESTACIONAMENTO_ID INTEGER,FOREIGN KEY(CLIENTE_ID) REFERENCES PUBLIC.CLIENTE(ID),FOREIGN KEY(VEICULO_PLACA) REFERENCES PUBLIC.VEICULO(PLACA),FOREIGN KEY(VAGA_ID) REFERENCES PUBLIC.VAGA(ID),FOREIGN KEY(ESTACIONAMENTO_ID) REFERENCES PUBLIC.ESTACIONAMENTO(ID))
ALTER TABLE PUBLIC.RESERVA ALTER COLUMN ID RESTART WITH 4
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
SET DATABASE DEFAULT INITIAL SCHEMA PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.SQL_IDENTIFIER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.YES_OR_NO TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.TIME_STAMP TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CARDINAL_NUMBER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CHARACTER_DATA TO PUBLIC
